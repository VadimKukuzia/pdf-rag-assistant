# ==========================================
# Google Gemini API Settings (Обов'язково)
# ==========================================
GEMINI_API_KEY="AIz..."

# ==========================================
# Database Settings
# ==========================================
DATABASE_URL="sqlite+aiosqlite:///./chat_history.db"

# ==========================================
# Streamlit UI Settings
# ==========================================
# Для локального запуску: http://localhost:8000
# Всередині Docker Compose значення перевизначається через environment у docker-compose.yml (http://api:8000)
API_BASE_URL="http://localhost:8000"

# ==========================================
# LangSmith Observability & Tracing (Опціонально)
# ==========================================
LANGCHAIN_TRACING_V2="true"
LANGCHAIN_API_KEY="lsv2_pt_..."
LANGCHAIN_PROJECT="rag..."